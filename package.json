{
  "name": "regex-assistant",
  "displayName": "Regex Assistant",
  "description": "An all-in-one assistant for understanding and working with regular expressions directly in VS Code.",
  "publisher": "emrekayakucuk",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/emr-k/regex-assistant"
  },
  "version": "1.0.2",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:go"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
    "activitybar": [
      {
        "id": "regex-helper-sidebar",
        "title": "Regex Helper",
        "icon": "resources/bar_icon.svg"
      }
    ]
  },
    "views": {
    "regex-helper-sidebar": [
      {
        "id": "regexHelperView",
        "name": "Workbench & Snippets",
        "type": "webview",
        "icon": "resources/bar_icon.svg"
      }
    ]
  }
},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "regexp-tree": "^0.1.27"
  }
}
